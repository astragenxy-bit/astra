# ═══════════════════════════════════════════════════════════
# WorkLearn Platform AI-Native — Environment Variables
# Copy: cp .env.example .env && fill real values
# ═══════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────
NODE_ENV=production
FRONTEND_PORT=3000
BACKEND_PORT=4000

# ── Domain (change this!) ───────────────────────────────────
CORS_ORIGIN=https://career.jockerow.com
VITE_API_URL=https://career.jockerow.com/api/v1
VITE_WS_URL=wss://career.jockerow.com

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=worklearn
POSTGRES_USER=worklearn
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ── JWT (generate: openssl rand -base64 64) ──────────────────
JWT_SECRET=CHANGE_ME_64_char_random_string_openssl_rand_base64_64
JWT_EXPIRES_IN=7d

# ── ANTHROPIC CLAUDE (required for AI features) ─────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXX

# ── FPAY Foxpay (get from foxpay.vn, needs business license) ─
FPAY_MERCHANT_ID=your_merchant_id
FPAY_SECRET_KEY=your_fpay_secret_key
FPAY_API_URL=https://api.foxpay.vn/v1
FPAY_WEBHOOK_SECRET=your_webhook_hmac_secret

# ── MinIO (local dev) / Cloudflare R2 (production) ──────────
# MinIO (docker):
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_BUCKET=worklearn
VITE_MINIO_PUBLIC_URL=http://localhost:9000/worklearn

# Cloudflare R2 (production — set these to use R2 instead of MinIO):
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# ── Email (SendGrid recommended for production) ──────────────
# SendGrid: EMAIL_HOST=smtp.sendgrid.net, USER=apikey, PASS=SG.xxxx
# Gmail (dev only): EMAIL_HOST=smtp.gmail.com, USER=your@gmail.com, PASS=app_password
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=SG.XXXXXXXXXXXX
EMAIL_FROM=WorkLearn <noreply@career.jockerow.com>

# ── Cloudflare (optional, for edge caching) ──────────────────
# Get from: https://dash.cloudflare.com → Workers & Pages
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_ID=

# ── Monitoring (optional) ────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
